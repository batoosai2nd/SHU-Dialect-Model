# 小沪项目配置示例。复制为 .env 后填写；不要把真实密钥提交到 Git。
DATABASE_URL=sqlite+aiosqlite:///./chat.db

# 大模型
DEEPSEEK_API_KEY=
CHATGPT_API_KEY=
GEMINI_API_KEY=
OLLAMA_ENDPOINT=

# TeleSpeech ASR HTTP API
# localhost/127.0.0.1 指部署小沪后端的生产服务器，不是文学馆展陈电脑。
SHANGHAI_ASR_URL=http://127.0.0.1:5000/api/asr
SHANGHAI_ASR_API_KEY=
SHANGHAI_ASR_MODEL_ID=test2
SHANGHAI_ASR_DIALECT=auto
SHANGHAI_ASR_USE_KALDI=true
SHANGHAI_ASR_ENABLE_PUNCTUATION=true
SHANGHAI_ASR_TIMEOUT_SECONDS=120

# Bert-VITS2 FastAPI v2
# 请先访问 TTS_API_BASE/models/registry，按实际注册表填写模型和说话人。
TTS_API_BASE=http://127.0.0.1:54322
TTS_MODEL=
TTS_SPEAKER=
# 留空时使用模型默认语言（推荐）。
TTS_LANG=
TTS_EMOTION=Neutral
TTS_SDP_RATIO=0.2
TTS_NOISE=0.6
TTS_NOISE_W=0.8
TTS_LENGTH_SCALE=1.0
TTS_AUTO_SPLIT=true
TTS_TIMEOUT_SECONDS=300

# 文学馆临时会话兜底清理
MUSEUM_SESSION_RETENTION_HOURS=24
MUSEUM_CLEANUP_INTERVAL_SECONDS=3600
